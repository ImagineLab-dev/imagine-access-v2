# Supabase
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_TEST_EMAIL=admin@example.com
SUPABASE_TEST_PASSWORD=change_me

# QR Code Signing Secret (Edge Functions)
QR_SECRET_KEY=YOUR_QR_SECRET_KEY

# SMTP (Edge Functions - ticket emails)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=tickets@imaginelab.shop
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_DEBUG=false

# CORS (Edge Functions)
ALLOWED_ORIGIN=https://your-app-domain.com
ENVIRONMENT=production
